{
  "name": "dynamo-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A secure local DynamoDB explorer",
  "license": "MIT",
  "author": "Guillermo Fuentes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfuentesdev/dynamo-explorer.git"
  },
  "homepage": "https://github.com/gfuentesdev/dynamo-explorer#readme",
  "bugs": {
    "url": "https://github.com/gfuentesdev/dynamo-explorer/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "local:db": "docker run --rm -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -inMemory",
    "local:seed": "node local-dynamodb/seed.mjs",
    "dev:local": "node local-dynamodb/start-app.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/credential-providers": "^3.883.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.5.1",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.3"
  }
}
